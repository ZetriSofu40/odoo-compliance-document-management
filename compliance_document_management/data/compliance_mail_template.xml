<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_compliance_expiry_reminder" model="mail.template">
            <field name="name">Compliance: Document Expiry Reminder</field>
            <field name="model_id" ref="model_compliance_document"/>
            <field name="subject">Compliance reminder: {{ object.name }} expires on {{ object.expiry_date }}</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="description">Sent by compliance reminder policies before a document expires</field>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 13px;">
    <p>Hello <t t-out="object.responsible_user_id.name or ''">Compliance Officer</t>,</p>
    <p>
        The compliance document <strong t-out="object.name or ''">Trade License</strong>
        (<t t-out="object.reference or ''">CMP/2026/00001</t>) for
        <strong t-out="object.holder_display_name or ''">Your Company</strong>
        expires on <strong t-out="object.expiry_date or ''">2026-12-31</strong>.
    </p>
    <p>
        Document type: <t t-out="object.document_type_id.display_name or ''"/><br/>
        Document number: <t t-out="object.document_number or 'Not provided'"/><br/>
        Days remaining: <t t-out="object.days_to_expiry"/>
    </p>
    <p>Please review the document and start its renewal when appropriate.</p>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>

