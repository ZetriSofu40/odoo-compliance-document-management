<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_compliance" model="res.groups.privilege">
        <field name="name">Compliance</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_compliance_reader" model="res.groups">
        <field name="name">Auditor: Read-only</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_compliance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_compliance_user" model="res.groups">
        <field name="name">Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_compliance_reader'))]"/>
    </record>

    <record id="group_compliance_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_compliance_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_compliance_document_company" model="ir.rule">
            <field name="name">Compliance Documents: Multi-company</field>
            <field name="model_id" ref="model_compliance_document"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_compliance_document_type_company" model="ir.rule">
            <field name="name">Compliance Document Types: Multi-company</field>
            <field name="model_id" ref="model_compliance_document_type"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_compliance_reminder_rule_company" model="ir.rule">
            <field name="name">Compliance Reminder Rules: Multi-company</field>
            <field name="model_id" ref="model_compliance_document_reminder_rule"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_compliance_tag_company" model="ir.rule">
            <field name="name">Compliance Tags: Multi-company</field>
            <field name="model_id" ref="model_compliance_document_tag"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_compliance_reminder_log_company" model="ir.rule">
            <field name="name">Compliance Reminder Logs: Multi-company</field>
            <field name="model_id" ref="model_compliance_document_reminder_log"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>

